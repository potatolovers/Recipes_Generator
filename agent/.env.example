# Copy to .env (git-ignored). Real environment variables override this file.

# The backend sends this value in the X-Api-Key header. Local development value only;
# deployed services read the real key from Key Vault.
AGENT_API_KEY=dev-local-key
# MOCK=1 returns examples/response_succeeded.json without calling any model.
MOCK=1

# Foundry project; not needed while MOCK=1.
# The Foundry resource's full /openai/v1 address, used exactly as written (serves gpt models and embeddings).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Deployment names: nano model for classify, mini model for web search + synthesis.
AGENT_MODEL_CLASSIFY=
AGENT_MODEL_MAIN=
AGENT_MODEL_TIMEOUT_SECONDS=60

# Optional small, cheap deployment for lightweight work, e.g. labeling cooking methods (python -m kb.methods).
# Falls back to AGENT_MODEL_CLASSIFY when empty.
AGENT_MODEL_LIGHTWEIGHT=gpt-4.1-mini

# Embedding deployment for the recipe knowledge base (M2), e.g. text-embedding-3-small.
AGENT_MODEL_EMBED=

# Azure AI Search, the recipe knowledge base (M2). The admin key can change the index: keep it on the
# laptop that runs kb.upload, never in the Container App. The deployed agent gets the read-only query key.
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX=recipes-v1
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=

# langgraph dev only: keep Studio runs on this machine (no traces sent to LangSmith).
LANGSMITH_TRACING=false
